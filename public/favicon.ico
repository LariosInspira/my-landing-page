<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="favGold" x1="60" y1="180" x2="450" y2="340" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#D69F2C"/>
      <stop offset="40%" stop-color="#E5BB4C"/>
      <stop offset="70%" stop-color="#DFAC37"/>
      <stop offset="100%" stop-color="#C79222"/>
    </linearGradient>
    <linearGradient id="favHeart" x1="256" y1="145" x2="256" y2="235" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#E45D3B"/>
      <stop offset="100%" stop-color="#D44A28"/>
    </linearGradient>
  </defs>

  <!-- Circular Badge Background in Brand Emerald Green -->
  <circle cx="256" cy="256" r="248" fill="#1B4D3E"/>

  <!-- Infinity Ribbon (Gold) -->
  <path
    d="M 256,268 
       C 284,234 330,172 388,172 
       C 440,172 472,212 472,268 
       C 472,324 434,358 384,358 
       C 334,358 284,302 256,268 
       C 228,302 178,358 128,358 
       C 78,358 40,324 40,268 
       C 40,212 72,172 124,172 
       C 182,172 228,234 256,268 Z"
    fill="none"
    stroke="url(#favGold)"
    stroke-width="26"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- White Brush Stroke Accent -->
  <path
    d="M 256,268 
       C 282,238 325,185 382,185 
       C 426,185 456,220 456,268 
       C 456,312 424,345 382,345 
       C 344,345 298,302 256,268 
       C 214,302 168,345 130,345 
       C 88,345 56,312 56,268 
       C 56,220 86,185 130,185 
       C 187,185 230,238 256,268 Z"
    fill="none"
    stroke="#FFFFFF"
    stroke-width="4.5"
    stroke-linecap="round"
    opacity="0.9"
  />

  <!-- Fine Whispering Brush Stroke (Tail/Accent) -->
  <path
    d="M 265,278 
       C 290,315 320,338 360,348"
    fill="none"
    stroke="#FFFFFF"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.6"
  />

  <!-- Terracotta Orange Heart -->
  <path
    d="M 256,233 
       C 252,225 220,192 220,172 
       C 220,155 234,144 249,155 
       C 253,158 256,162 256,162 
       C 256,162 259,158 263,155 
       C 278,144 292,155 292,172 
       C 292,192 260,225 256,233 Z"
    fill="url(#favHeart)"
  />
</svg>